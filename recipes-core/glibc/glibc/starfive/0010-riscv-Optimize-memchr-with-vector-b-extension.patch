From: "max.ma" <max.ma@starfivetech.com>
Date: Sat, 29 Jun 2024 19:11:08 -0700
Subject: [PATCH 10/17] riscv: Optimize memchr with vector & b extension

Signed-off-by: max.ma <max.ma@starfivetech.com>
---
 sysdeps/riscv/multiarch/memchr_generic.S      | 92 +++++++++++++++++++
 sysdeps/riscv/multiarch/memchr_vector.S       | 42 +++++++++
 .../unix/sysv/linux/riscv/multiarch/Makefile  |  2 +
 .../linux/riscv/multiarch/ifunc-impl-list.c   |  5 +
 .../unix/sysv/linux/riscv/multiarch/memchr.c  | 56 +++++++++++
 5 files changed, 197 insertions(+)
 create mode 100644 sysdeps/riscv/multiarch/memchr_generic.S
 create mode 100644 sysdeps/riscv/multiarch/memchr_vector.S
 create mode 100644 sysdeps/unix/sysv/linux/riscv/multiarch/memchr.c

diff --git a/sysdeps/riscv/multiarch/memchr_generic.S b/sysdeps/riscv/multiarch/memchr_generic.S
new file mode 100644
index 0000000000..a9a943e2f1
--- /dev/null
+++ b/sysdeps/riscv/multiarch/memchr_generic.S
@@ -0,0 +1,92 @@
+/* The assembly function for memchr.  RISC-V version.
+   Copyright (C) 2018 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library.  If not, see
+   <http://www.gnu.org/licenses/>.  */
+
+#include <sysdep.h>
+
+.option arch, +zbb
+
+	.p2align 6
+ENTRY (__memchr_generic)
+    beqz    a2, .L_not_find
+    li      a4, 9
+    bltu    a2, a4, .L_0_to_8
+    neg     a4, a0
+    andi    a4, a4, 0x7
+    beqz    a4, .L_dst_aligned
+.L_0_to_8:
+    min     a4, a4, a2
+.L_head:
+    sub     a2, a2, a4
+0:
+    lbu     a3, 0(a0)
+    beq     a1, a3, .L_find_byte
+    addi    a4, a4, -1
+    addi    a0, a0, 1
+    bnez    a4, 0b
+    beqz    a2, .L_not_find
+
+.L_dst_aligned:
+    andi    a4, a2, (16-1)
+    srli    a2, a2, 4
+    beqz    a2, .L_tail
+    
+    slli    a3, a1, 8
+    or      a1, a1, a3
+    slli    a3, a1, 16
+    or      a1, a1, a3
+    slli    a3, a1, 32
+    or      a1, a1, a3
+    li      a5, -1
+    .p2align 3
+.L_loop:
+    ld      a3, 0(a0)
+    xor     a3, a3, a1
+    orc.b   a3, a3
+    bne     a3, a5, .L_find
+    addi    a0, a0, 8
+    
+    ld      a3, 0(a0)
+    xor     a3, a3, a1
+    orc.b   a3, a3
+    bne     a3, a5, .L_find
+    
+    addi    a2, a2, -1
+    add     a0, a0, 8
+    bnez    a2, .L_loop
+    beqz    a4, .L_not_find
+
+.L_tail:
+    andi    a1, a1, 0xff
+0:
+    lbu     a3, 0(a0)
+    beq     a1, a3, .L_find_byte
+    addi    a4, a4, -1
+    addi    a0, a0, 1
+    bnez    a4, 0b
+
+.L_not_find:
+    li      a0, 0
+    ret
+.L_find:
+    not     a3, a3
+    ctz     a3, a3
+    srli    a3, a3, 3
+    add     a0, a0, a3
+.L_find_byte:
+    ret
+END (__memchr_generic)
\ No newline at end of file
diff --git a/sysdeps/riscv/multiarch/memchr_vector.S b/sysdeps/riscv/multiarch/memchr_vector.S
new file mode 100644
index 0000000000..a0bc0315c3
--- /dev/null
+++ b/sysdeps/riscv/multiarch/memchr_vector.S
@@ -0,0 +1,42 @@
+/* The assembly function for memchr.  RISC-V version.
+   Copyright (C) 2018 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
