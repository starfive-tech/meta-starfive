diff --git a/sysdeps/riscv/multiarch/memcpy_generic.S b/sysdeps/riscv/multiarch/memcpy_generic.S
new file mode 100644
index 0000000000..904445a428
--- /dev/null
+++ b/sysdeps/riscv/multiarch/memcpy_generic.S
@@ -0,0 +1,132 @@
+#include <sysdep.h>
+
+#if IS_IN (libc) && defined SHARED
+#define MEMCPY __memcpy_generic
+#else
+#ifndef MEMCPY
+# define MEMCPY memcpy
+#endif
+#endif
+
+.macro copy_32B d, s
+    ld      a3, 0(\s)
+    sd      a3, 0(\d)
+    ld      a3, 8(\s)
+    sd      a3, 8(\d)
+    ld      a3, 16(\s)
+    sd      a3, 16(\d)
+    ld      a3, 24(\s)
+    sd      a3, 24(\d)
+.endm
+
+    .p2align 6
+ENTRY (MEMCPY)
+    mv      a5, a0
+    li      a4, 9
+    bltu    a2, a4, .L_byte
+
+    neg     a4, a5
+    andi    a4, a4, 0x7
+    beqz    a4, .L_dst_aligned
+    j       .L_pc_0
+
+.L_byte:
+    mv      a4, a2
+
+.L_pc_0:
+    auipc   a3, 0
+    slli    t0, a4, 3
+    sub     a3, a3, t0
+    .equ    offset_0, .L_jmp_end_0 - .L_pc_0
+    jalr    x0, a3, %lo(offset_0)
+    lb      a3, 7(a1)
+    sb      a3, 7(a5)
+    lb      a3, 6(a1)
+    sb      a3, 6(a5)
+    lb      a3, 5(a1)
+    sb      a3, 5(a5)
+    lb      a3, 4(a1)
+    sb      a3, 4(a5)
+    lb      a3, 3(a1)
+    sb      a3, 3(a5)
+    lb      a3, 2(a1)
+    sb      a3, 2(a5)
+    lb      a3, 1(a1)
+    sb      a3, 1(a5)
+    lb      a3, 0(a1)
+    sb      a3, 0(a5)
+.L_jmp_end_0:
+    sub     a2, a2, a4          /* update cnt */
+    beqz    a2, .L_ret
+    add     a5, a5, a4
+    add     a1, a1, a4
+
+.L_dst_aligned:
+    andi    t5, a1, 0x7
+    bnez    t5, .L_merge
+    andi    a4, a2, -32
+    beqz    a4, .L_tail
+    add     a4, a4, a5
+    .p2align  3
+.L_loop:
+    copy_32B a5, a1
+    addi    a5, a5, 32
+    addi    a1, a1, 32
+    bltu    a5, a4, .L_loop
+    andi    a2, a2, (32-1)
+    beqz    a2, .L_ret
+
+.L_tail:
+    andi    a4, a2, -8
+.L_pc:
+    auipc   a3, 0
+    srli    t0, a4, 1
+    sub     a3, a3, t0
+    .equ    offset, .L_jmp_end - .L_pc
+    jalr    x0, a3, %lo(offset)
+    ld      a3, 16(a1)
+    sd      a3, 16(a5)
+    ld      a3, 8(a1)
+    sd      a3, 8(a5)
+    ld      a3, 0(a1)
+    sd      a3, 0(a5)
+.L_jmp_end:
+    add     a1, a1, a4
+    add     a5, a5, a4
+    andi    a2, a2, (8 - 1)     /* update cnt */
+    j       .L_byte
+
+.L_ret:
+    ret
+
+    .balign 4
+.L_merge:
+    andi    a4, a2, -8
+    andi    a2, a2, (8 - 1)     /* update cnt */
+    beqz    a4, .L_byte
+    add     a4, a4, a5
+    andi    a1, a1, -8
+    ld      t2, 0(a1)
+    slli    t3, t5, 3
+    neg     t4, t3
+    andi    t4, t4, (64 - 1)
+    srl     t1, t2, t3
+    .p2align 3
+1:
+    ld      t2, 8(a1)
+    sll     a3, t2, t4
+    or      a3, a3, t1
+    sd      a3, 0(a5)
+    srl     t1, t2, t3
+
+    addi    a5, a5, 8
+    addi    a1, a1, 8
+    bltu    a5, a4, 1b
+    beqz    a2, .L_ret
+    add     a1, a1, t5
+    j       .L_byte
+END (MEMCPY)
+
+#if !(IS_IN (libc) && defined SHARED)
+libc_hidden_builtin_def (MEMCPY)
+#endif
