From 53b36d215b668675b669411d7f000b5b7ae66b10 Mon Sep 17 00:00:00 2001
From: "max.ma" <max.ma@starfivetech.com>
Date: Sat, 29 Jun 2024 19:19:10 -0700
Subject: [PATCH 11/17] riscv: Optimize memcmp with vector extension

Signed-off-by: max.ma <max.ma@starfivetech.com>
---
 sysdeps/riscv/multiarch/memcmp_generic.S      | 132 ++++++++++++++++++
 sysdeps/riscv/multiarch/memcmp_vector.S       |  47 +++++++
 .../unix/sysv/linux/riscv/multiarch/Makefile  |   2 +
 .../linux/riscv/multiarch/ifunc-impl-list.c   |   5 +
 .../unix/sysv/linux/riscv/multiarch/memcmp.c  |  57 ++++++++
 5 files changed, 243 insertions(+)
 create mode 100644 sysdeps/riscv/multiarch/memcmp_generic.S
 create mode 100644 sysdeps/riscv/multiarch/memcmp_vector.S
 create mode 100644 sysdeps/unix/sysv/linux/riscv/multiarch/memcmp.c

diff --git a/sysdeps/riscv/multiarch/memcmp_generic.S b/sysdeps/riscv/multiarch/memcmp_generic.S
new file mode 100644
index 0000000000..17b39e2730
--- /dev/null
+++ b/sysdeps/riscv/multiarch/memcmp_generic.S
@@ -0,0 +1,132 @@
+/* The assembly function for memcmp.  RISC-V version.
+   Copyright (C) 2018 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library.  If not, see
+   <http://www.gnu.org/licenses/>.  */
+
+#include <sysdep.h>
+.option arch, +zbb
+
+	.p2align 6
+ENTRY (__memcmp_generic)
+    mv      a5, a0
+    li      a4, 9
+    bltu    a2, a4, .L_0_to_8
+
+    neg     a4, a5
+    andi    a4, a4, 0x7
+    beqz    a4, .L_8B_aligned
+
+.L_0_to_8:
+    min     a4, a4, a2
+.L_head:
+    beqz    a4, 2f
+    sub     a2, a2, a4
+    add     a4, a4, a5
+0:
+    lbu     a3, 0(a1)
+    lbu     a0, 0(a5)
+    bne     a3, a0, 1f
+    addi    a1, a1, 1
+    addi    a5, a5, 1
+    bltu    a5, a4, 0b
+    beqz    a2, 2f
+    j       .L_8B_aligned
+1:
+    sub     a0, a0, a3
+    ret
+2:
+    li      a0, 0
+    ret
+.L_8B_aligned:
+    andi    a4, a2, -16
+    beqz    a4, .L_byte
+    add     a4, a4, a5
+    andi    t5, a1, 0x7
+    andi    a2, a2, (16-1)
+    bnez    t5, .L_merge
+    .p2align 3
+.L_loop:
+    ld      a3, 0(a1)
+    ld      a0, 0(a5)
+    bne     a3, a0, .L_end
+    ld      a3, 8(a1)
+    ld      a0, 8(a5)
+    bne     a3, a0, .L_end
+    addi    a5, a5, 16
+    addi    a1, a1, 16
+    bltu    a5, a4, .L_loop
+    bnez    a2, .L_byte
+
+.L_end:
+    rev8    a0, a0
+    rev8    a3, a3
+    bltu    a0, a3, 2f
+    beq     a0, a3, 3f
+    li      a0, 1
+    ret
+2:
+    li      a0, -1
+    ret
+3:
+    li      a0, 0
+    ret
+
+.L_byte:
+    add     a2, a2, a5
+0:
+    lbu     a3, 0(a1)
+    lbu     a4, 0(a5)
+    bne     a3, a4, 1f
+    addi    a5, a5, 1
+    addi    a1, a1, 1
+    bltu    a5, a2, 0b
+1:
+    sub     a0, a4, a3
+    ret
+2:
+    li      a0, 0
+    ret
+
+.L_merge:
+    andi    a1, a1, -8
+    ld      t2, 0(a1)
+    slli    t3, t5, 3
+    neg     t4, t3
+    andi    t4, t4, (64 - 1)
+    srl     t1, t2, t3
+    .p2align 3
+1:
+    ld      t2, 8(a1)
+    sll     a3, t2, t4
+    or      a3, a3, t1
+    ld      a0, 0(a5)
+    bne     a3, a0, .L_end
+    srl     t1, t2, t3
+
+    ld      t2, 16(a1)
+    sll     a3, t2, t4
+    or      a3, a3, t1
+    ld      a0, 8(a5)
+    bne     a3, a0, .L_end
+    srl     t1, t2, t3
+
+    addi    a5, a5, 16
+    addi    a1, a1, 16
+    bltu    a5, a4, 1b
+    beqz    a2, .L_end
+    add     a1, a1, t5
+    j       .L_byte
+END (__memcmp_generic)
\ No newline at end of file
diff --git a/sysdeps/riscv/multiarch/memcmp_vector.S b/sysdeps/riscv/multiarch/memcmp_vector.S
new file mode 100644
index 0000000000..324495b622
--- /dev/null
+++ b/sysdeps/riscv/multiarch/memcmp_vector.S
@@ -0,0 +1,47 @@
+/* The assembly function for memcmp.  RISC-V version.
+   Copyright (C) 2018 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library.  If not, see
+   <http://www.gnu.org/licenses/>.  */
+
+#include <sysdep.h>
+
+	.p2align 6
+ENTRY (__memcmp_vector)
+
+.L_compare_loop:
+   vsetvli	a3,a2,e8,m8,tu,mu
+   vle8.v	v0,(a0)
+   vle8.v	v8,(a1)
+   vmsne.vv	v16,v0,v8
+   sub	a2,a2,a3
+   vfirst.m	a4,v16
+   bgez	a4,.L_compare_not_equal
+   add	a0,a0,a3
+   add	a1,a1,a3
+   bltu	zero,a2,.L_compare_loop
+   bltz	a4,.L_compare_equal
+
+.L_compare_not_equal:
+   add	a0,a0,a4
+   add	a1,a1,a4
+   lbu	a5,0(a0)
+   lbu	a6,0(a1)
+   sub	a0,a5,a6
+   ret
+.L_compare_equal:
+   add	a0,zero,zero
+   ret
+END (__memcmp_vector)
\ No newline at end of file
diff --git a/sysdeps/unix/sysv/linux/riscv/multiarch/Makefile b/sysdeps/unix/sysv/linux/riscv/multiarch/Makefile
index 7d17cabdf9..27fa1b34fe 100644
--- a/sysdeps/unix/sysv/linux/riscv/multiarch/Makefile
+++ b/sysdeps/unix/sysv/linux/riscv/multiarch/Makefile
@@ -6,6 +6,8 @@ sysdep_routines += \
   memcpy_vector \
   memchr_generic \
   memchr_vector \
+  memcmp_generic \
+  memcmp_vector \
   # sysdep_routines
 
 CFLAGS-memcpy_noalignment.c += -mno-strict-align
diff --git a/sysdeps/unix/sysv/linux/riscv/multiarch/ifunc-impl-list.c b/sysdeps/unix/sysv/linux/riscv/multiarch/ifunc-impl-list.c
index 2561ae7e1a..ce69bdb8dc 100644
--- a/sysdeps/unix/sysv/linux/riscv/multiarch/ifunc-impl-list.c
+++ b/sysdeps/unix/sysv/linux/riscv/multiarch/ifunc-impl-list.c
@@ -54,5 +54,10 @@ __libc_ifunc_impl_list (const char *name, struct libc_ifunc_impl *array,
 			      __memchr_vector)
 	      IFUNC_IMPL_ADD (array, i, memchr, 1, __memchr_generic))
 
+  IFUNC_IMPL (i, name, memcmp,
+	      IFUNC_IMPL_ADD (array, i, memcmp, support_vector,
+			      __memcmp_vector)
+	      IFUNC_IMPL_ADD (array, i, memcmp, 1, __memcmp_generic))
+
   return 0;
 }
diff --git a/sysdeps/unix/sysv/linux/riscv/multiarch/memcmp.c b/sysdeps/unix/sysv/linux/riscv/multiarch/memcmp.c
new file mode 100644
index 0000000000..324fbef613
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/riscv/multiarch/memcmp.c
@@ -0,0 +1,57 @@
+/* Multiple versions of memcmp.
+   All versions must be listed in ifunc-impl-list.c.
+   Copyright (C) 2017-2024 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+#if IS_IN (libc)
+/* Redefine memcmp so that the compiler won't complain about the type
+   mismatch with the IFUNC selector in strong_alias, below.  */
+# undef memcmp
+# define memcmp __redirect_memcmp
+# include <stdint.h>
+# include <string.h>
+# include <ifunc-init.h>
+# include <riscv-ifunc.h>
+# include <sys/hwprobe.h>
+
+extern __typeof (__redirect_memcmp) __libc_memcmp;
+
+extern __typeof (__redirect_memcmp) __memcmp_generic attribute_hidden;
+extern __typeof (__redirect_memcmp) __memcmp_vector attribute_hidden;
+
+static inline __typeof (__redirect_memcmp) *
+select_memcmp_ifunc (uint64_t dl_hwcap, __riscv_hwprobe_t hwprobe_func)
+{
+  unsigned long long int v;
+  if (__riscv_hwprobe_one (hwprobe_func, RISCV_HWPROBE_KEY_IMA_EXT_0, &v) == 0
+      && (v & RISCV_HWPROBE_IMA_V))
+    return __memcmp_vector;
+
+  return __memcmp_generic;
+}
+
+riscv_libc_ifunc (__libc_memcmp, select_memcmp_ifunc);
+
+# undef memcmp
+strong_alias (__libc_memcmp, memcmp);
+# ifdef SHARED
+__hidden_ver1 (memcmp, __GI_memcmp, __redirect_memcmp)
+__attribute__ ((visibility ("hidden"))) __attribute_copy__ (memcmp);
+# endif
+#else
+# include <string/memcmp.c>
+#endif
