From: "demin.han" <demin.han@starfivetech.com>
Date: Thu, 17 Oct 2024 09:33:30 +0800
Subject: [PATCH 17/17] Fix bcmp missing in so

---
 sysdeps/unix/sysv/linux/riscv/multiarch/memcmp.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/sysdeps/unix/sysv/linux/riscv/multiarch/memcmp.c b/sysdeps/unix/sysv/linux/riscv/multiarch/memcmp.c
index ad3195b628..7565989a02 100644
--- a/sysdeps/unix/sysv/linux/riscv/multiarch/memcmp.c
+++ b/sysdeps/unix/sysv/linux/riscv/multiarch/memcmp.c
@@ -50,6 +50,15 @@ riscv_libc_ifunc (__libc_memcmp, select_memcmp_ifunc);
 strong_alias (__libc_memcmp, memcmp);
 __hidden_ver1 (memcmp, __GI_memcmp, __redirect_memcmp)
 __attribute__ ((visibility ("hidden"))) __attribute_copy__ (memcmp);
+
+# ifdef weak_alias
+#  undef bcmp
+weak_alias (memcmp, bcmp)
+# endif
+
+# undef __memcmpeq
+strong_alias (memcmp, __memcmpeq)
+libc_hidden_def(__memcmpeq)
 #else
 //memcmp_generic.S
 #endif
