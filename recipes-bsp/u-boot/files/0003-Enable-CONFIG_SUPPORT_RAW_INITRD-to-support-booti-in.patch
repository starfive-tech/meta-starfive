From d757afd298d07bfbda8f1a68218599d67d4b8b3f Mon Sep 17 00:00:00 2001
From: Andy Hu <andy.hu@starfivetech.com>
Date: Mon, 29 Jun 2026 15:47:19 +0800
Subject: [PATCH] Enable CONFIG_SUPPORT_RAW_INITRD to support booti initramfs

Upstream-Status: Submitted

Signed-off-by: Andy Hu <andy.hu@starfivetech.com>
---
 configs/starfive_dubhe_fpga_defconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/configs/starfive_dubhe_fpga_defconfig b/configs/starfive_dubhe_fpga_defconfig
index e9d2387f60c..79fa883fe9c 100644
--- a/configs/starfive_dubhe_fpga_defconfig
+++ b/configs/starfive_dubhe_fpga_defconfig
@@ -24,6 +24,7 @@ CONFIG_RISCV_SMODE=y
 CONFIG_FIT=y
 CONFIG_SPL_LOAD_FIT_ADDRESS=0x84000000
 CONFIG_SPL_LOAD_FIT_APPLY_OVERLAY=y
+CONFIG_SUPPORT_RAW_INITRD=y
 CONFIG_USE_BOOTARGS=y
 CONFIG_BOOTARGS="console=ttySIF0,115200 earlycon=sbi ip=:::255.255.255.0::eth0:dhcp"
 CONFIG_USE_BOOTCOMMAND=y
