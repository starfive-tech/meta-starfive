diff --git a/include/opcode/riscv-opc.h b/include/opcode/riscv-opc.h
index 66187de6b8a..1512291f12c 100644
--- a/include/opcode/riscv-opc.h
+++ b/include/opcode/riscv-opc.h
@@ -295,15 +295,6 @@
 #define MASK_SFENCE_VMA  0xfe007fff
 #define MATCH_WFI 0x10500073
 #define MASK_WFI  0xffffffff
-#define MASK_CUSTOMER_PREF 0x7fff
-#define MATCH_CFLUSH_D_L1    0xfc000073
-#define MASK_CFLUSH_D_L1     0xfff07fff
-#define MATCH_CDISCARD_D_L1  0xfc200073
-#define MASK_CDISCARD_D_L1   0xfff07fff
-#define MATCH_CFLUSH_D_L2    0xfc400073
-#define MASK_CFLUSH_D_L2     0xfff07fff
-#define MATCH_CDISCARD_D_L2  0xfc600073
-#define MASK_CDISCARD_D_L2   0xfff07fff
 #define MATCH_CSRRW 0x1073
 #define MASK_CSRRW  0x707f
 #define MATCH_CSRRS 0x2073
@@ -3171,6 +3162,17 @@
 /* Vendor-specific (SiFive) cease instruction.  */
 #define MATCH_SF_CEASE 0x30500073
 #define MASK_SF_CEASE 0xffffffff
+/* Vendor-specific (StarFive Technology) processor CMO instructions. */
+#define MATCH_ST_CMO_PREF   0x2013
+#define MASK_ST_CMO_PREF    0x7fff
+#define MATCH_ST_CMO_CFLUSH_D_L1    0xfc000073
+#define MASK_ST_CMO_CFLUSH_D_L1     0xfff07fff
+#define MATCH_ST_CMO_CDISCARD_D_L1  0xfc200073
+#define MASK_ST_CMO_CDISCARD_D_L1   0xfff07fff
+#define MATCH_ST_CMO_CFLUSH_D_L2    0xfc400073
+#define MASK_ST_CMO_CFLUSH_D_L2     0xfff07fff
+#define MATCH_ST_CMO_CDISCARD_D_L2  0xfc600073
+#define MASK_ST_CMO_CDISCARD_D_L2   0xfff07fff
 /* Unprivileged Counter/Timers CSR addresses.  */
 #define CSR_CYCLE 0xc00
 #define CSR_TIME 0xc01
@@ -3762,10 +3764,6 @@ DECLARE_INSN(dret, MATCH_DRET, MASK_DRET)
 DECLARE_INSN(sfence_vm, MATCH_SFENCE_VM, MASK_SFENCE_VM)
 DECLARE_INSN(sfence_vma, MATCH_SFENCE_VMA, MASK_SFENCE_VMA)
 DECLARE_INSN(wfi, MATCH_WFI, MASK_WFI)
-DECLARE_INSN(cflush_d_l1, MATCH_CFLUSH_D_L1, MASK_CFLUSH_D_L1)
-DECLARE_INSN(cdiscard_d_l1, MATCH_CDISCARD_D_L1, MASK_CDISCARD_D_L1)
-DECLARE_INSN(cflush_d_l2, MATCH_CFLUSH_D_L2, MASK_CFLUSH_D_L2)
-DECLARE_INSN(cdiscard_d_l2, MATCH_CDISCARD_D_L2, MASK_CDISCARD_D_L2)
 DECLARE_INSN(csrrw, MATCH_CSRRW, MASK_CSRRW)
 DECLARE_INSN(csrrs, MATCH_CSRRS, MASK_CSRRS)
 DECLARE_INSN(csrrc, MATCH_CSRRC, MASK_CSRRC)
@@ -4230,6 +4228,11 @@ DECLARE_INSN(th_sync_s, MATCH_TH_SYNC_S, MASK_TH_SYNC_S)
 /* XVentanaCondOps instructions. */
 DECLARE_INSN(vt_maskc, MATCH_VT_MASKC, MASK_VT_MASKC)
 DECLARE_INSN(vt_maskcn, MATCH_VT_MASKCN, MASK_VT_MASKCN)
+/* Vendor-specific (StarFive Technology) processor CMO instructions. */
+DECLARE_INSN(cflush_d_l1, MATCH_ST_CMO_CFLUSH_D_L1, MASK_ST_CMO_CFLUSH_D_L1)
+DECLARE_INSN(cdiscard_d_l1, MATCH_ST_CMO_CDISCARD_D_L1, MASK_ST_CMO_CDISCARD_D_L1)
+DECLARE_INSN(cflush_d_l2, MATCH_ST_CMO_CFLUSH_D_L2, MASK_ST_CMO_CFLUSH_D_L2)
+DECLARE_INSN(cdiscard_d_l2, MATCH_ST_CMO_CDISCARD_D_L2, MASK_ST_CMO_CDISCARD_D_L2)
 #endif /* DECLARE_INSN */
 #ifdef DECLARE_CSR
 /* Unprivileged Counter/Timers CSRs.  */
diff --git a/include/opcode/riscv.h b/include/opcode/riscv.h
index 2f4d2fd2b36..1b427591a2f 100644
--- a/include/opcode/riscv.h
+++ b/include/opcode/riscv.h
@@ -526,6 +526,7 @@ enum riscv_insn_class
   INSN_CLASS_XVENTANACONDOPS,
   INSN_CLASS_XSFVCP,
   INSN_CLASS_XSFCEASE,
+  INSN_CLASS_XSTCMO,
 };
 
 /* This structure holds information for a particular instruction.  */
diff --git a/opcodes/riscv-opc.c b/opcodes/riscv-opc.c
index 7953fda2f86..da73d7edc74 100644
--- a/opcodes/riscv-opc.c
+++ b/opcodes/riscv-opc.c
@@ -525,7 +525,6 @@ const struct riscv_opcode riscv_opcodes[] =
 {"snez",        0, INSN_CLASS_I, "d,t",       MATCH_SLTU, MASK_SLTU|MASK_RS1, match_opcode, INSN_ALIAS },
 {"sltz",        0, INSN_CLASS_I, "d,s",       MATCH_SLT, MASK_SLT|MASK_RS2, match_opcode, INSN_ALIAS },
 {"sgtz",        0, INSN_CLASS_I, "d,t",       MATCH_SLT, MASK_SLT|MASK_RS1, match_opcode, INSN_ALIAS },
-{"pref",        0, INSN_CLASS_I, "#,+(s)",    MATCH_SLTI, MASK_CUSTOMER_PREF, match_opcode, INSN_ALIAS },
 {"slti",        0, INSN_CLASS_I, "d,s,j",     MATCH_SLTI, MASK_SLTI, match_opcode, 0 },
 {"slt",         0, INSN_CLASS_I, "d,s,t",     MATCH_SLT, MASK_SLT, match_opcode, 0 },
 {"slt",         0, INSN_CLASS_I, "d,s,j",     MATCH_SLTI, MASK_SLTI, match_opcode, INSN_ALIAS },
@@ -2156,10 +2155,6 @@ const struct riscv_opcode riscv_opcodes[] =
 {"csrrci",     0, INSN_CLASS_ZICSR, "d,E,Z", MATCH_CSRRCI, MASK_CSRRCI, match_opcode, 0 },
 {"csrrc",      0, INSN_CLASS_ZICSR, "d,E,s", MATCH_CSRRC, MASK_CSRRC, match_opcode, 0 },
 {"csrrc",      0, INSN_CLASS_ZICSR, "d,E,Z", MATCH_CSRRCI, MASK_CSRRCI, match_opcode, INSN_ALIAS },
-{"cflush.d.l1",   0, INSN_CLASS_ZICSR,   "s", 	MATCH_CFLUSH_D_L1, MASK_CFLUSH_D_L1, match_opcode, 0 },
-{"cdiscard.d.l1", 0, INSN_CLASS_ZICSR,   "s",   MATCH_CDISCARD_D_L1, MASK_CDISCARD_D_L1, match_opcode, 0 },
-{"cflush.d.l2",   0, INSN_CLASS_ZICSR,   "s",   MATCH_CFLUSH_D_L2, MASK_CFLUSH_D_L2, match_opcode, 0 },
-{"cdiscard.d.l2", 0, INSN_CLASS_ZICSR,   "s",   MATCH_CDISCARD_D_L2, MASK_CDISCARD_D_L2, match_opcode, 0 },
 {"uret",       0, INSN_CLASS_I, "",    MATCH_URET, MASK_URET, match_opcode, 0 },
 {"sret",       0, INSN_CLASS_I, "",    MATCH_SRET, MASK_SRET, match_opcode, 0 },
 {"hret",       0, INSN_CLASS_I, "",    MATCH_HRET, MASK_HRET, match_opcode, 0 },
@@ -3129,6 +3124,13 @@ const struct riscv_opcode riscv_opcodes[] =
 /* Vendor-specific (SiFive) cease instruction.  */
 {"sf.cease", 0, INSN_CLASS_XSFCEASE, "", MATCH_SF_CEASE, MASK_SF_CEASE, match_opcode, 0 },
 
+/* Vendor-specific (StarFive Technology) processor CMO instructions. */
+{"pref",          0, INSN_CLASS_XSTCMO, "#,+(s)", MATCH_ST_CMO_PREF, MASK_ST_CMO_PREF, match_opcode, INSN_ALIAS },
+{"cflush.d.l1",   0, INSN_CLASS_XSTCMO, "s",      MATCH_ST_CMO_CFLUSH_D_L1, MASK_ST_CMO_CFLUSH_D_L1, match_opcode, 0 },
+{"cdiscard.d.l1", 0, INSN_CLASS_XSTCMO, "s",      MATCH_ST_CMO_CDISCARD_D_L1, MASK_ST_CMO_CDISCARD_D_L1, match_opcode, 0 },
+{"cflush.d.l2",   0, INSN_CLASS_XSTCMO, "s",      MATCH_ST_CMO_CFLUSH_D_L2, MASK_ST_CMO_CFLUSH_D_L2, match_opcode, 0 },
+{"cdiscard.d.l2", 0, INSN_CLASS_XSTCMO, "s",      MATCH_ST_CMO_CDISCARD_D_L2, MASK_ST_CMO_CDISCARD_D_L2, match_opcode, 0 },
+
 /* Terminate the list.  */
 {0, 0, INSN_CLASS_NONE, 0, 0, 0, 0, 0}
 };
