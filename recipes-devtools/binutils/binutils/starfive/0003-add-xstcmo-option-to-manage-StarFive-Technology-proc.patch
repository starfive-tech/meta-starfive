From d9c335c2717375b3d397bade96c32c1a16fc46b7 Mon Sep 17 00:00:00 2001
From: "yilun.xie" <yilun.xie@starfivetech.com>
Date: Thu, 15 Aug 2024 16:16:49 +0800
Subject: [PATCH 3/3] add xstcmo option to manage StarFive Technology processor
 CMO instructions

---
 bfd/elfxx-riscv.c                             |  5 ++++
 gas/testsuite/gas/riscv/march-help.l          |  1 +
 gas/testsuite/gas/riscv/pref.d                | 16 ----------
 gas/testsuite/gas/riscv/pref.s                |  7 -----
 .../gas/riscv/{csr-custom.d => x-st-cmo.d}    |  6 ++--
 .../gas/riscv/{csr-custom.s => x-st-cmo.s}    |  0
 include/opcode/riscv-opc.h                    | 29 ++++++++++---------
 include/opcode/riscv.h                        |  1 +
 opcodes/riscv-opc.c                           | 12 ++++----
 9 files changed, 33 insertions(+), 44 deletions(-)
 delete mode 100644 gas/testsuite/gas/riscv/pref.d
 delete mode 100644 gas/testsuite/gas/riscv/pref.s
 rename gas/testsuite/gas/riscv/{csr-custom.d => x-st-cmo.d} (81%)
 rename gas/testsuite/gas/riscv/{csr-custom.s => x-st-cmo.s} (100%)

diff --git a/bfd/elfxx-riscv.c b/bfd/elfxx-riscv.c
index b3adbed1913..3b5ae647911 100644
--- a/bfd/elfxx-riscv.c
+++ b/bfd/elfxx-riscv.c
@@ -1485,6 +1485,7 @@ static struct riscv_supported_ext riscv_supported_vendor_x_ext[] =
   {"xventanacondops",	ISA_SPEC_CLASS_DRAFT,	1, 0, 0 },
   {"xsfvcp",		ISA_SPEC_CLASS_DRAFT,	1, 0, 0 },
   {"xsfcease",		ISA_SPEC_CLASS_DRAFT,	1, 0, 0 },
+  {"xstcmo",	        ISA_SPEC_CLASS_DRAFT,	1, 0, 0	},
   {NULL, 0, 0, 0, 0}
 };
 
@@ -2758,6 +2759,8 @@ riscv_multi_subset_supports (riscv_parse_subset_t *rps,
       return riscv_subset_supports (rps, "xsfvcp");
     case INSN_CLASS_XSFCEASE:
       return riscv_subset_supports (rps, "xsfcease");
+	case INSN_CLASS_XSTCMO:
+      return riscv_subset_supports (rps, "xstcmo");
     default:
       rps->error_handler
         (_("internal: unreachable INSN_CLASS_*"));
@@ -3028,6 +3031,8 @@ riscv_multi_subset_supports_ext (riscv_parse_subset_t *rps,
       return "xtheadzvamo";
     case INSN_CLASS_XSFCEASE:
       return "xsfcease";
+    case INSN_CLASS_XSTCMO:
+      return "xstcmo";	
     default:
       rps->error_handler
         (_("internal: unreachable INSN_CLASS_*"));
diff --git a/gas/testsuite/gas/riscv/march-help.l b/gas/testsuite/gas/riscv/march-help.l
index 97521c7c02b..864ba06e103 100644
--- a/gas/testsuite/gas/riscv/march-help.l
+++ b/gas/testsuite/gas/riscv/march-help.l
@@ -151,3 +151,4 @@ All available -march extensions for RISC-V:
 	xventanacondops                         1.0
 	xsfvcp                                  1.0
 	xsfcease                                1.0
+	xstcmo                                  1.0
