From 52a81240c0198943f2613c55ac23cf55338b4061 Mon Sep 17 00:00:00 2001
From: "yilun.xie" <yilun.xie@starfivetech.com>
Date: Wed, 19 Jun 2024 16:56:30 +0800
Subject: [PATCH 2/3] gas: riscv: Add customer CSR instructions

---
 gas/testsuite/gas/riscv/csr-custom.d | 18 ++++++++++++++++++
 gas/testsuite/gas/riscv/csr-custom.s |  9 +++++++++
 include/opcode/riscv-opc.h           | 12 ++++++++++++
 opcodes/riscv-opc.c                  |  4 ++++
 4 files changed, 43 insertions(+)
 create mode 100644 gas/testsuite/gas/riscv/csr-custom.d
 create mode 100644 gas/testsuite/gas/riscv/csr-custom.s

diff --git a/gas/testsuite/gas/riscv/csr-custom.d b/gas/testsuite/gas/riscv/csr-custom.d
new file mode 100644
index 00000000000..708efe17a43
--- /dev/null
+++ b/gas/testsuite/gas/riscv/csr-custom.d
@@ -0,0 +1,18 @@
+#as: -march=rv64i_zicsr
+#source: csr-custom.s
+#objdump: -d
+
+.*:[ 	]+file format .*
+
+
+Disassembly of section .text:
+
+0+000 <target>:
+[ 	]+0:[ 	]+fc050073[ 	]+cflush.d.l1[ 	]+a0
+[ 	]+4:[ 	]+fc450073[ 	]+cflush.d.l2[ 	]+a0
+[ 	]+8:[ 	]+fc250073[ 	]+cdiscard.d.l1[ 	]+a0
+[ 	]+c:[ 	]+fc650073[ 	]+cdiscard.d.l2[ 	]+a0
+[ 	]+10:[ 	]+fc600073[ 	]+cdiscard.d.l2[ 	]+zero
+[ 	]+14:[ 	]+fc200073[ 	]+cdiscard.d.l1[ 	]+zero
+[ 	]+18:[ 	]+fc400073[ 	]+cflush.d.l2[ 	]+zero
+[ 	]+1c:[ 	]+fc000073[ 	]+cflush.d.l1[ 	]+zero
\ No newline at end of file
diff --git a/gas/testsuite/gas/riscv/csr-custom.s b/gas/testsuite/gas/riscv/csr-custom.s
new file mode 100644
index 00000000000..8b5cc4126b2
--- /dev/null
+++ b/gas/testsuite/gas/riscv/csr-custom.s
@@ -0,0 +1,9 @@
+target:
+	cflush.d.l1	a0
+	cflush.d.l2	a0
+	cdiscard.d.l1	a0
+	cdiscard.d.l2	a0
+	cdiscard.d.l2	x0
+	cdiscard.d.l1	x0
+	cflush.d.l2	x0
+	cflush.d.l1	x0
diff --git a/include/opcode/riscv-opc.h b/include/opcode/riscv-opc.h
index cc7d98d882b..402272c6e87 100644
--- a/include/opcode/riscv-opc.h
+++ b/include/opcode/riscv-opc.h
@@ -256,6 +256,14 @@
 #define MATCH_WFI 0x10500073
 #define MASK_WFI  0xffffffff
 #define MASK_CUSTOMER_PREF 0x7fff
+#define MATCH_CFLUSH_D_L1    0xfc000073
+#define MASK_CFLUSH_D_L1     0xfff07fff
+#define MATCH_CDISCARD_D_L1  0xfc200073
+#define MASK_CDISCARD_D_L1   0xfff07fff
+#define MATCH_CFLUSH_D_L2    0xfc400073
+#define MASK_CFLUSH_D_L2     0xfff07fff
+#define MATCH_CDISCARD_D_L2  0xfc600073
+#define MASK_CDISCARD_D_L2   0xfff07fff
 #define MATCH_CSRRW 0x1073
 #define MASK_CSRRW  0x707f
 #define MATCH_CSRRS 0x2073
@@ -3116,6 +3124,10 @@ DECLARE_INSN(csrrc, MATCH_CSRRC, MASK_CSRRC)
 DECLARE_INSN(csrrwi, MATCH_CSRRWI, MASK_CSRRWI)
 DECLARE_INSN(csrrsi, MATCH_CSRRSI, MASK_CSRRSI)
 DECLARE_INSN(csrrci, MATCH_CSRRCI, MASK_CSRRCI)
+DECLARE_INSN(cflush_d_l1, MATCH_CFLUSH_D_L1, MASK_CFLUSH_D_L1)
+DECLARE_INSN(cdiscard_d_l1, MATCH_CDISCARD_D_L1, MASK_CDISCARD_D_L1)
+DECLARE_INSN(cflush_d_l2, MATCH_CFLUSH_D_L2, MASK_CFLUSH_D_L2)
+DECLARE_INSN(cdiscard_d_l2, MATCH_CDISCARD_D_L2, MASK_CDISCARD_D_L2)
 DECLARE_INSN(fadd_s, MATCH_FADD_S, MASK_FADD_S)
 DECLARE_INSN(fsub_s, MATCH_FSUB_S, MASK_FSUB_S)
 DECLARE_INSN(fmul_s, MATCH_FMUL_S, MASK_FMUL_S)
diff --git a/opcodes/riscv-opc.c b/opcodes/riscv-opc.c
index b7c6ee296ca..4b19f8086fd 100644
--- a/opcodes/riscv-opc.c
+++ b/opcodes/riscv-opc.c
@@ -2000,6 +2000,10 @@ const struct riscv_opcode riscv_opcodes[] =
 {"csrrci",     0, INSN_CLASS_ZICSR, "d,E,Z", MATCH_CSRRCI, MASK_CSRRCI, match_opcode, 0 },
 {"csrrc",      0, INSN_CLASS_ZICSR, "d,E,s", MATCH_CSRRC, MASK_CSRRC, match_opcode, 0 },
 {"csrrc",      0, INSN_CLASS_ZICSR, "d,E,Z", MATCH_CSRRCI, MASK_CSRRCI, match_opcode, INSN_ALIAS },
+{"cflush.d.l1",   0, INSN_CLASS_ZICSR,   "s", 	MATCH_CFLUSH_D_L1, MASK_CFLUSH_D_L1, match_opcode, 0 },
+{"cdiscard.d.l1", 0, INSN_CLASS_ZICSR,   "s",   MATCH_CDISCARD_D_L1, MASK_CDISCARD_D_L1, match_opcode, 0 },
+{"cflush.d.l2",   0, INSN_CLASS_ZICSR,   "s",   MATCH_CFLUSH_D_L2, MASK_CFLUSH_D_L2, match_opcode, 0 },
+{"cdiscard.d.l2", 0, INSN_CLASS_ZICSR,   "s",   MATCH_CDISCARD_D_L2, MASK_CDISCARD_D_L2, match_opcode, 0 },
 {"uret",       0, INSN_CLASS_I, "",    MATCH_URET, MASK_URET, match_opcode, 0 },
 {"sret",       0, INSN_CLASS_I, "",    MATCH_SRET, MASK_SRET, match_opcode, 0 },
 {"hret",       0, INSN_CLASS_I, "",    MATCH_HRET, MASK_HRET, match_opcode, 0 },
-- 
2.25.1

