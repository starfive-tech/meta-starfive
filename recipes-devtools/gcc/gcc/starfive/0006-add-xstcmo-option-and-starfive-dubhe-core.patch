From 453365e8929f4a55f9b27f661bcf41d46cec73f4 Mon Sep 17 00:00:00 2001
From: "yilun.xie" <yilun.xie@starfivetech.com>
Date: Thu, 15 Aug 2024 16:23:40 +0800
Subject: [PATCH 6/7] add xstcmo option and starfive dubhe core

---
 gcc/common/config/riscv/riscv-common.cc |  4 ++++
 gcc/config/riscv/riscv-cores.def        |  6 ++++++
 gcc/config/riscv/riscv.cc               | 17 +++++++++++++++++
 gcc/config/riscv/riscv.opt              |  5 +++++
 gcc/doc/invoke.texi                     |  4 ++++
 5 files changed, 36 insertions(+)

diff --git a/gcc/common/config/riscv/riscv-common.cc b/gcc/common/config/riscv/riscv-common.cc
index ab47d26e74a..57ed5820286 100644
--- a/gcc/common/config/riscv/riscv-common.cc
+++ b/gcc/common/config/riscv/riscv-common.cc
@@ -389,6 +389,8 @@ static const struct riscv_ext_version riscv_ext_version_table[] =
 
   {"xventanacondops", ISA_SPEC_CLASS_NONE, 1, 0},
 
+  {"xstcmo", ISA_SPEC_CLASS_NONE, 1, 0},
+
   /* Terminate the list.  */
   {NULL, ISA_SPEC_CLASS_NONE, 0, 0}
 };
@@ -1685,6 +1687,8 @@ static const riscv_ext_flag_table_t riscv_ext_flag_table[] =
 
   {"xventanacondops", &gcc_options::x_riscv_xventana_subext, MASK_XVENTANACONDOPS},
 
+  {"xstcmo",      &gcc_options::x_riscv_xstcmo_subext, MASK_XSTCMO},
+
   {NULL, NULL, 0}
 };
 
diff --git a/gcc/config/riscv/riscv-cores.def b/gcc/config/riscv/riscv-cores.def
index 2f5efe3be86..d05d0ec386d 100644
--- a/gcc/config/riscv/riscv-cores.def
+++ b/gcc/config/riscv/riscv-cores.def
@@ -41,6 +41,7 @@ RISCV_TUNE("sifive-p400-series", sifive_p400, sifive_p400_tune_info)
 RISCV_TUNE("sifive-p600-series", sifive_p600, sifive_p600_tune_info)
 RISCV_TUNE("thead-c906", generic, thead_c906_tune_info)
 RISCV_TUNE("xiangshan-nanhu", xiangshan, xiangshan_nanhu_tune_info)
+RISCV_TUNE("starfive-dubhe", generic, starfive_dubhe_tune_info)
 RISCV_TUNE("generic-ooo", generic_ooo, generic_ooo_tune_info)
 RISCV_TUNE("size", generic, optimize_size_tune_info)
 
@@ -96,4 +97,9 @@ RISCV_CORE("xiangshan-nanhu",      "rv64imafdc_zba_zbb_zbc_zbs_"
 			      "zbkb_zbkc_zbkx_zknd_zkne_zknh_zksed_zksh_"
 			      "svinval_zicbom_zicboz",
 			      "xiangshan-nanhu")
+
+RISCV_CORE("starfive-dubhe",  "rv64imafdc_zba_zbb_zbc_zbs_"
+               "xstcmo",
+               "starfive-dubhe")
+
 #undef RISCV_CORE
diff --git a/gcc/config/riscv/riscv.cc b/gcc/config/riscv/riscv.cc
index 9c6f9ca243e..ca6b3b2fe3b 100644
--- a/gcc/config/riscv/riscv.cc
+++ b/gcc/config/riscv/riscv.cc
@@ -515,6 +515,23 @@ static const struct riscv_tune_param xiangshan_nanhu_tune_info = {
   NULL,						/* vector cost */
 };
 
+/* Costs to use when optimizing for StarFive Dubhe.  */
+static const struct riscv_tune_param starfive_dubhe_tune_info = {
+  {COSTS_N_INSNS (4), COSTS_N_INSNS (5)},	/* fp_add */
+  {COSTS_N_INSNS (4), COSTS_N_INSNS (5)},	/* fp_mul */
+  {COSTS_N_INSNS (20), COSTS_N_INSNS (20)},	/* fp_div */
+  {COSTS_N_INSNS (4), COSTS_N_INSNS (4)},	/* int_mul */
+  {COSTS_N_INSNS (33), COSTS_N_INSNS (65)},	/* int_div */
+  1,						/* issue_rate */
+  3,						/* branch_cost */
+  5,						/* memory_cost */
+  8,						/* fmv_cost */
+  true,						/* slow_unaligned_access */
+  false,					/* use_divmod_expansion */
+  RISCV_FUSE_NOTHING,                           /* fusible_ops */
+  NULL,						/* vector cost */
+};
+
 /* Costs to use when optimizing for a generic ooo profile.  */
 static const struct riscv_tune_param generic_ooo_tune_info = {
   {COSTS_N_INSNS (2), COSTS_N_INSNS (2)},	/* fp_add */
diff --git a/gcc/config/riscv/riscv.opt b/gcc/config/riscv/riscv.opt
index 1874b9ab717..3b4deb0c1c2 100644
--- a/gcc/config/riscv/riscv.opt
+++ b/gcc/config/riscv/riscv.opt
@@ -491,6 +491,11 @@ int riscv_xventana_subext
 
 Mask(XVENTANACONDOPS) Var(riscv_xventana_subext)
 
+TargetVariable
+int riscv_xstcmo_subext
+
+Mask(XSTCMO)      Var(riscv_xstcmo_subext)
+
 Enum
 Name(isa_spec_class) Type(enum riscv_isa_spec_class)
 Supported ISA specs (for use with the -misa-spec= option):
diff --git a/gcc/doc/invoke.texi b/gcc/doc/invoke.texi
index 80476bcf37a..d1a085ef8c2 100644
--- a/gcc/doc/invoke.texi
+++ b/gcc/doc/invoke.texi
@@ -30911,6 +30911,10 @@ to @samp{zvks} and @samp{zvkg}.
 @tab 1.0
 @tab Ventana integer conditional operations extension.
 
+@item xstcmo
+@tab 1.0
+@tab StarFive Technology processor CMO extension.
+
 @end multitable
 
 When @option{-march=} is not specified, use the setting from @option{-mcpu}.
-- 
2.25.1

